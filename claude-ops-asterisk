#!/usr/bin/python3 -I
"""Asterisk helper for the ops MCP server. Runs as root via sudo with fixed subcommands.

  claude-ops-asterisk show-conf <name.conf>          print a config with secrets masked
  claude-ops-asterisk list-backups [name.conf]       list backups made by install-conf
  claude-ops-asterisk log [lines]                    tail the Asterisk full/messages log
  (readable: pjsip.conf extensions.conf rtp.conf musiconhold.conf;
   installable: pjsip.conf extensions.conf musiconhold.conf)
  claude-ops-asterisk install-conf <workfile> <name.conf>
        copy a file from the MCP work dir over /etc/asterisk/<name.conf>, after backing up the
        current file. Lines like `password = __KEEP_SECRET__` keep the value that is already in
        the live file (same section, same key), so secrets never have to pass through Claude.
        Files that use System/SHELL/AGI/Exec/FILE/MixMonitor/Lua or #include/#exec are refused.
  claude-ops-asterisk restore-conf <name.conf>       put back the newest backup

Reloading Asterisk is a separate step (`asterisk -rx "pjsip reload"`).
"""
import os
import re
import shutil
import stat
import sys
import time

ETC = "/etc/asterisk"
WORK = "/opt/claude-ops/work"
BACKUP = "/var/lib/claude-ops/asterisk-backups"
MASK = "__KEEP_SECRET__"
SECRET_KEYS = {"password", "secret", "md5_cred", "md5secret", "auth_secret", "private_key",
               "priv_key_file_password", "outbound_proxy_password", "passwd", "api_key",
               "apikey", "token", "auth_token", "access_token", "client_secret"}
CONF_NAME = re.compile(r"^[a-z0-9_-]+\.conf$")
# Only these files can be read or replaced. Control-plane files (asterisk.conf, modules.conf,
# manager.conf, ari.conf, http.conf, extconfig.conf, logger.conf ...) are never touched.
READABLE = {"pjsip.conf", "extensions.conf", "rtp.conf", "musiconhold.conf"}
INSTALLABLE = {"pjsip.conf", "extensions.conf", "musiconhold.conf"}
# Config content that could run OS commands, write files or pull in other files is refused.
FORBIDDEN = re.compile(
    r"(^\s*#\s*(exec|include|tryinclude)\b)"
    r"|\b(System|TrySystem|SHELL|AGI|EAGI|DeadAGI|AsyncAGI|ExternalIVR|Exec|TryExec|ExecIf"
    r"|MixMonitor|Monitor|FILE|Lua|JabberSend|ODBC_\w*)\s*\(",
    re.IGNORECASE | re.MULTILINE)
SECRET_INLINE = re.compile(r"(?i)(authorization:\s*\S+\s+|(password|secret|token)\s*[=:]\s*)\S+")
WORK_NAME = re.compile(r"^[A-Za-z0-9._-]+$")
KV = re.compile(r"^(\s*)([A-Za-z0-9_]+)(\s*=>?\s*)(.*)$")
SECTION = re.compile(r"^\s*\[([^\]]+)\]")
MAX_SIZE = 200_000


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def conf_path(name, allowed=READABLE):
    if not CONF_NAME.match(name) or name not in allowed:
        die(f"config must be one of: {', '.join(sorted(allowed))}")
    return os.path.join(ETC, name)


def mask_lines(text):
    out = []
    for line in text.splitlines():
        m = KV.match(line)
        if m and m.group(2).lower() in SECRET_KEYS and m.group(4).strip():
            line = f"{m.group(1)}{m.group(2)}{m.group(3)}{MASK}"
        else:
            line = SECRET_INLINE.sub(lambda x: x.group(1) + MASK, line)
        out.append(line)
    return "\n".join(out) + "\n"


def secrets_by_section(text):
    found, section = {}, ""
    for line in text.splitlines():
        s = SECTION.match(line)
        if s:
            section = s.group(1).strip()
            continue
        m = KV.match(line)
        if m and m.group(2).lower() in SECRET_KEYS:
            found.setdefault((section, m.group(2).lower()), m.group(4).split(";")[0].strip())
    return found


def show_conf(name):
    path = conf_path(name)
    try:
        with open(path) as f:
            sys.stdout.write(mask_lines(f.read()))
    except OSError as e:
        die(f"cannot read {path}: {e.strerror}")


def list_backups(name=None):
    if not os.path.isdir(BACKUP):
        print("(no backups yet)")
        return
    files = sorted(os.listdir(BACKUP))
    if name:
        conf_path(name)
        files = [f for f in files if f.startswith(name + ".")]
    print("\n".join(files) if files else "(no backups yet)")


def tail_log(lines="200"):
    if not lines.isdigit() or not 1 <= int(lines) <= 2000:
        die("lines must be 1-2000")
    for path in (f"/var/log/asterisk/full", "/var/log/asterisk/messages.log",
                 "/var/log/asterisk/messages"):
        if os.path.isfile(path):
            with open(path, errors="replace") as f:
                data = f.readlines()[-int(lines):]
            print(f"== {path} (last {len(data)} lines) ==")
            sys.stdout.write(mask_lines("".join(data)))
            return
    die("no Asterisk log file found in /var/log/asterisk")


def backup(path):
    os.makedirs(BACKUP, mode=0o700, exist_ok=True)
    dest = os.path.join(BACKUP, f"{os.path.basename(path)}.{time.strftime('%Y%m%d-%H%M%S')}")
    shutil.copy2(path, dest)
    os.chmod(dest, 0o600)
    return dest


def install_conf(workfile, name):
    if not WORK_NAME.match(workfile) or workfile in (".", ".."):
        die("work file must be a plain file name in the work dir")
    path = conf_path(name, INSTALLABLE)
    src = os.path.join(WORK, workfile)
    # open first (no symlinks), then check what was actually opened: no check-then-open race
    try:
        fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        die(f"{src} not found or is a link (write it with write_file first)")
    st_src = os.fstat(fd)
    if not stat.S_ISREG(st_src.st_mode) or st_src.st_size > MAX_SIZE:
        os.close(fd)
        die("work file must be a regular file under 200 KB")
    with os.fdopen(fd, "r", encoding="utf-8", errors="strict") as f:
        new = f.read()
    bad = FORBIDDEN.search(new)
    if bad:
        line_no = new.count("\n", 0, bad.start()) + 1
        die(f"refused: line {line_no} uses '{bad.group(0).strip()}' (commands, file access and "
            "includes are not allowed in configs installed this way; edit on the server instead)")
    old = ""
    if os.path.isfile(path):
        with open(path) as f:
            old = f.read()
    keep = secrets_by_section(old)

    out, section = [], ""
    for n, line in enumerate(new.splitlines(), 1):
        s = SECTION.match(line)
        if s:
            section = s.group(1).strip()
        m = KV.match(line)
        if m and MASK in m.group(4):
            key = (section, m.group(2).lower())
            if key not in keep:
                die(f"line {n}: no existing {m.group(2)} for [{section}] in {name} to keep")
            line = f"{m.group(1)}{m.group(2)}{m.group(3)}{keep[key]}"
        out.append(line)
    text = "\n".join(out) + "\n"

    st = os.stat(path) if old else None
    saved = backup(path) if old else "(new file, nothing to back up)"
    tmp = path + ".claude-tmp"
    with open(tmp, "w") as f:
        f.write(text)
    if st:
        os.chown(tmp, st.st_uid, st.st_gid)
        os.chmod(tmp, st.st_mode & 0o7777)
    else:
        os.chmod(tmp, 0o640)
    os.replace(tmp, path)
    print(f"installed {path} ({len(text)} bytes)\nbackup: {saved}")
    print('next: reload, e.g. asterisk -rx "pjsip reload" or asterisk -rx "dialplan reload"')


def restore_conf(name):
    path = conf_path(name, INSTALLABLE)
    files = sorted(f for f in (os.listdir(BACKUP) if os.path.isdir(BACKUP) else [])
                   if f.startswith(name + "."))
    if not files:
        die(f"no backups of {name}")
    latest = os.path.join(BACKUP, files[-1])
    st = os.stat(path) if os.path.isfile(path) else None
    if st:
        backup(path)
    shutil.copyfile(latest, path)
    if st:
        os.chown(path, st.st_uid, st.st_gid)
        os.chmod(path, st.st_mode & 0o7777)
    print(f"restored {path} from {latest}")


def main(argv):
    if not argv:
        die(__doc__)
    cmd, args = argv[0], argv[1:]
    if cmd == "show-conf" and len(args) == 1:
        show_conf(args[0])
    elif cmd == "list-backups" and len(args) <= 1:
        list_backups(*args)
    elif cmd == "log" and len(args) <= 1:
        tail_log(*args)
    elif cmd == "install-conf" and len(args) == 2:
        install_conf(*args)
    elif cmd == "restore-conf" and len(args) == 1:
        restore_conf(args[0])
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
